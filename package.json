{
  "name": "labkit",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "LabKit SDK: generic runtime, UI, audio and MIDI building blocks for browser laboratories",
  "engines": {
    "node": "24.15.0"
  },
  "types": "./dist/types/index.d.ts",
  "main": "./dist/labkit.js",
  "module": "./dist/labkit.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/labkit.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./labkit.css": "./dist/labkit.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "npm run typecheck:src && npm run typecheck:tests && npm run typecheck:tools",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "build": "vite build && tsc -p tsconfig.types.json",
    "build:fixtures": "vite build --config vite.fixtures.config.ts",
    "test:unit": "vitest run",
    "test:browser": "playwright test --project=browser",
    "test:package": "npm run build && node --test tests/package/*.test.mjs",
    "test": "npm run test:unit && npm run test:browser && npm run test:package",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --max-warnings=0",
    "test:consumer": "node scripts/test-consumer.mjs",
    "prepare": "npm run build",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "jsdom": "30.1.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sborod/labkit.git"
  }
}
